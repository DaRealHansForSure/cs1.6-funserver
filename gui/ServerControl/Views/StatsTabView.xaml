<UserControl x:Class="ServerControl.Views.StatsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Map timer -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Map time" Style="{StaticResource SectionTitle}" />
            <ProgressBar Value="{Binding MapProgress, Mode=OneWay}" Maximum="100" />
            <TextBlock Text="{Binding MapProgressText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Period and filter -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />
            <CheckBox DockPanel.Dock="Right" Content="Hide bots" IsChecked="{Binding HideBots}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <ListBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource FilterItem}" VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- Leaderboard -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="6,0,6,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="2" Text="Kills" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="3" Text="Deaths" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="4" Text="K/D" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="5" Text="Knife" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="6" Text="HE" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="7" Text="Fails" Style="{StaticResource SectionTitle}" Margin="0" ToolTip="Suicides, falls, own grenades" />
                    <TextBlock Grid.Column="8" Text="Best weapon" Style="{StaticResource SectionTitle}" Margin="0" />
                </Grid>
                <Border Style="{StaticResource SunkenPanel}">
                    <Border Style="{StaticResource SunkenPanelShade}" Padding="6,2">
                        <ListBox ItemsSource="{Binding Leaderboard}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.Name}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Stats.IsBot}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Stats.Kills}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Stats.Deaths}" />
                                        <TextBlock Grid.Column="4" Text="{Binding KillDeathText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Stats.KnifeKills}" />
                                        <TextBlock Grid.Column="6" Text="{Binding Stats.GrenadeKills}" />
                                        <TextBlock Grid.Column="7" Text="{Binding Stats.Suicides}" />
                                        <TextBlock Grid.Column="8" Text="{Binding Stats.FavoriteWeapon}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </DockPanel>

            <!-- Maps played -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="6,0,6,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Start" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="Map tonight" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Grid.Column="2" Text="Played" Style="{StaticResource SectionTitle}" Margin="0" />
                </Grid>
                <Border Style="{StaticResource SunkenPanel}">
                    <Border Style="{StaticResource SunkenPanelShade}" Padding="6,2">
                        <ListBox ItemsSource="{Binding MapsPlayed}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="126" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StartText}" Foreground="{StaticResource MutedBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Play.Map}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
