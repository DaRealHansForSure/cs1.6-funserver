<UserControl x:Class="ServerControl.Views.PlayersTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="14,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Off" Command="{Binding BotsOffCommand}" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="+1" Command="{Binding AddBotCommand}" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="-1" Command="{Binding RemoveBotCommand}" Margin="4,0,0,0" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0">
                <Run Text="Bots:" /> <Run Text="{Binding BotQuota, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
            </TextBlock>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="Bold" />
        </DockPanel>

        <!-- Column header like the in-game scoreboard -->
        <Grid DockPanel.Dock="Top" Margin="6,0,6,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Grid.Column="2" Text="Kills" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Grid.Column="3" Text="Time" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock Grid.Column="4" Text="Ping" Style="{StaticResource SectionTitle}" Margin="0" />
        </Grid>

        <Border Style="{StaticResource SunkenPanel}">
            <Border Style="{StaticResource SunkenPanelShade}" Padding="6,2">
                <ListBox ItemsSource="{Binding Players}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BareItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="372" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="player" />
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBot}" Value="True">
                                                    <Setter Property="Text" Value="bot" />
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Frags}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Time}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Ping}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Glow" Padding="6,1" Margin="2,0,0,0"
                                            Command="{Binding DataContext.GlowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Unglow" Padding="6,1" Margin="2,0,0,0"
                                            Command="{Binding DataContext.UnglowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Rocket" Padding="6,1" Margin="2,0,0,0"
                                            Command="{Binding DataContext.RocketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="God" Padding="6,1" Margin="2,0,0,0" ToolTip="Godmode on"
                                            Command="{Binding DataContext.GodmodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Noclip" Padding="6,1" Margin="2,0,0,0"
                                            Command="{Binding DataContext.NoclipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Slay" Padding="6,1" Margin="2,0,0,0"
                                            Command="{Binding DataContext.SlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="Kick" Padding="6,1" Margin="2,0,0,0"
                                            Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
