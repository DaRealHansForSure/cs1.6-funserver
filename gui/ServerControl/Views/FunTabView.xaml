<UserControl x:Class="ServerControl.Views.FunTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Next round is a fun round (Classic only)" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding FunRounds}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Margin="0,0,4,4" Padding="6,7"
                                Command="{Binding DataContext.ForceFunRoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Switch mode now (map changes after 5 seconds)" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding Modes}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Margin="0,0,4,4" Padding="6,7"
                                Command="{Binding DataContext.SwitchModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Round and hook" Style="{StaticResource SectionTitle}" />
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Restart round" Command="{Binding RestartRoundCommand}" Margin="0,0,4,0" />
                <Button Content="Hook on" Command="{Binding HookOnCommand}" Margin="0,0,4,0" />
                <Button Content="Hook off" Command="{Binding HookOffCommand}" />
            </WrapPanel>

            <TextBlock Text="Message to everybody" Style="{StaticResource SectionTitle}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Say" Command="{Binding SendChatCommand}" Margin="6,0,0,0" MinWidth="60" />
                <TextBox Text="{Binding ChatMessage, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
