<UserControl x:Class="ServerControl.Views.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Server" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Server name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Join password (empty = open)" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JoinPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Max players (next start)" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxPlayers, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="60" HorizontalAlignment="Left" />
            </Grid>

            <TextBlock Text="Fun" Style="{StaticResource SectionTitle}" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Fun round every n rounds" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FunRoundsEvery, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="60" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="1" Text="Hook speed (100 to 3000)" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HookSpeed, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="60" HorizontalAlignment="Left" />
            </Grid>
            <CheckBox Content="Fun rounds on" IsChecked="{Binding FunRoundsEnabled}" />
            <CheckBox Content="Only admins may use the hook" IsChecked="{Binding HookAdminOnly}" />

            <TextBlock Text="Bots per mode (they leave when humans join)" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <ItemsControl ItemsSource="{Binding BotsPerMode}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Mode.Title}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding BotCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="60" HorizontalAlignment="Left" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Surf maps always run without bots, they can not surf." />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Save and apply" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" />
                <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource RunningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StoppedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Saved to server\cstrike\local.cfg (bots in local_&lt;mode&gt;.cfg), which run on every map start after the mode settings. Round times stay in server-files\cstrike\modes\*.cfg." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
