<UserControl x:Class="ServerControl.Views.MapsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadCommand}" />
            <TextBlock DockPanel.Dock="Left" Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
            <TextBox DockPanel.Dock="Left" Width="160" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" />
            <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource FilterItem}" VerticalAlignment="Center">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                   Text="Play changes the map on the running server. First map picks it for the next start on the Server tab." />

        <Border Style="{StaticResource SunkenPanel}">
            <Border Style="{StaticResource SunkenPanelShade}" Padding="6,6,0,0">
                <ListBox ItemsSource="{Binding Tiles}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BareItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="172" Margin="0,0,6,6" Style="{StaticResource RaisedPanel}">
                                <Border Style="{StaticResource RaisedPanelShade}" Padding="4">
                                    <StackPanel>
                                        <Grid Height="96" Background="{StaticResource DeepBrush}">
                                            <TextBlock Text="{Binding Prefix}" Foreground="{StaticResource BevelLightBrush}" FontSize="20" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Preview}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Stretch" Value="UniformToFill" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRadar}" Value="True">
                                                                <Setter Property="Stretch" Value="Uniform" />
                                                                <Setter Property="Margin" Value="4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="2,5,2,1" />
                                        <TextBlock Text="{Binding ModeList}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="2,0,2,5" />
                                        <UniformGrid Columns="2">
                                            <Button Content="Play" Margin="0,0,2,0" Padding="4,2"
                                                    Command="{Binding DataContext.PlayNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="First map" Margin="2,0,0,0" Padding="4,2"
                                                    Command="{Binding DataContext.UseAsStartMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Border>
    </DockPanel>
</UserControl>
