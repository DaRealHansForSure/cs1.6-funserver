<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    The look of the CS 1.6 / old Steam interface (VGUI): olive surfaces,
    square edges, 1 px bevels (light top-left, dark bottom-right), Tahoma,
    gold for whatever is selected. No rounded corners, no shadows.
    -->

    <SolidColorBrush x:Key="WindowBrush" Color="#4C5844" />
    <SolidColorBrush x:Key="PanelBrush" Color="#3E4637" />
    <SolidColorBrush x:Key="DeepBrush" Color="#2F3529" />
    <SolidColorBrush x:Key="InputBrush" Color="#3E4637" />
    <SolidColorBrush x:Key="BevelLightBrush" Color="#8C9284" />
    <SolidColorBrush x:Key="BevelDarkBrush" Color="#292C21" />
    <SolidColorBrush x:Key="TextBrush" Color="#D8DED3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A0AA95" />
    <SolidColorBrush x:Key="GoldBrush" Color="#C4B550" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#958831" />
    <SolidColorBrush x:Key="RunningBrush" Color="#9FC85A" />
    <SolidColorBrush x:Key="StoppedBrush" Color="#D46A4C" />

    <FontFamily x:Key="UiFont">Tahoma, Verdana</FontFamily>
    <FontFamily x:Key="MonoFont">Lucida Console, Consolas</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Raised: light edge top-left, dark edge bottom-right. -->
    <Style x:Key="RaisedPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BevelLightBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
    </Style>

    <Style x:Key="RaisedPanelShade" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- Sunken: the other way round, for lists, inputs and the console. -->
    <Style x:Key="SunkenPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DeepBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BevelDarkBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
    </Style>

    <Style x:Key="SunkenPanelShade" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BevelLightBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource WindowBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Light" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BevelLightBrush}" BorderThickness="1,1,0,0">
                        <Border x:Name="Dark" BorderBrush="{StaticResource BevelDarkBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- Pressed buttons sink in: the bevel flips. -->
                            <Setter TargetName="Light" Property="BorderBrush" Value="{StaticResource BevelDarkBrush}" />
                            <Setter TargetName="Dark" Property="BorderBrush" Value="{StaticResource BevelLightBrush}" />
                            <Setter TargetName="Content" Property="Margin" Value="1,1,-1,-1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- The one main action of a view: same bevel, gold text. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BevelDarkBrush}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{StaticResource BevelLightBrush}" BorderThickness="0,0,1,1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="13" Height="13" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BevelDarkBrush}" BorderThickness="1,1,0,0" VerticalAlignment="Center">
                            <Border BorderBrush="{StaticResource BevelLightBrush}" BorderThickness="0,0,1,1">
                                <TextBlock x:Name="Mark" Text="x" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Hidden" />
                            </Border>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs across the top, the selected one joins the panel below it. -->
    <Style x:Key="TabItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BevelLightBrush}"
                            BorderThickness="1,1,0,0" Margin="0,3,2,0">
                        <Border x:Name="Shade" BorderBrush="{StaticResource BevelDarkBrush}" BorderThickness="0,0,1,0" Padding="14,4">
                            <ContentPresenter />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="Frame" Property="Margin" Value="0,0,2,-1" />
                            <Setter TargetName="Shade" Property="Padding" Value="14,6,14,6" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain toggle row, for the map filter: gold underline instead of a pill. -->
    <Style x:Key="FilterItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,3" Margin="0,0,2,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="BareItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars in the same style: flat olive track, raised thumb. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource DeepBrush}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BevelLightBrush}" BorderThickness="1,1,0,0">
                                                <Border BorderBrush="{StaticResource BevelDarkBrush}" BorderThickness="0,0,1,1" />
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
