<UserControl x:Class="CsServerControl.Maps.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:CsServerControl.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <services:ZeroToVisibleConverter x:Key="VisibleWhenZero" />

        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SmallSecondaryButton}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="56" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Maps" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeToolbar}" Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="{StaticResource CardGapColumn}" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Installed maps -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource Select}" Width="200" ItemsSource="{Binding Filters}"
                                  SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Title" AutomationProperties.Name="Show" />
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource TextInput}" Width="220" Margin="0,0,8,0" Tag="Search maps"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search maps" />
                        <TextBlock Text="Installed maps" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Map" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="Modes" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="3" Text="Source" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="4" Text="Navigation" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="5" Text="Size" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <!-- Same width as the row buttons, so the columns above line up. -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Visibility="Hidden">
                                <Button Content="Details" Style="{StaticResource RowButton}" />
                                <Button Content="Pick" Style="{StaticResource RowButton}" />
                                <Button Content="Next" Style="{StaticResource RowButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="No map matches." Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       Visibility="{Binding Rows.Count, Converter={StaticResource VisibleWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource ConsoleBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,5,0,5"
                                                Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="64" Height="36" HorizontalAlignment="Left" Background="{StaticResource InputBackground}"
                                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderOne}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeToolbar}"
                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <TextBlock x:Name="Modes" Grid.Column="2" Text="{Binding ModesText}" Style="{StaticResource Cell}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding SourceText}" Style="{StaticResource Cell}" />
                                                <TextBlock x:Name="Nav" Grid.Column="4" Text="{Binding NavText}" Style="{StaticResource Cell}"
                                                           Foreground="{StaticResource SuccessPillText}" />
                                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="Details" Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Details of {0}}" />
                                                    <Button Content="Pick" Style="{StaticResource RowButton}" IsEnabled="{Binding CanPick}"
                                                            Command="{Binding DataContext.PickOnServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Pick this map on the Server screen (a draft until Apply)"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Pick {0} on the Server screen}" />
                                                    <Button Content="Next" Style="{StaticResource RowButton}"
                                                            IsEnabled="{Binding DataContext.IsServerRunning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.SetNextMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Right away: this map comes after the current one"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Set {0} as next map}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasNav}" Value="False">
                                                <Setter TargetName="Nav" Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInNoMode}" Value="True">
                                                <Setter TargetName="Modes" Property="Foreground" Value="{StaticResource TextTertiary}" />
                                                <Setter TargetName="Nav" Property="Foreground" Value="{StaticResource TextTertiary}" />
                                            </DataTrigger>
                                            <!-- After IsInNoMode, so a broken map shows its warning instead of grey. -->
                                            <DataTrigger Binding="{Binding Entry.IsPlayable}" Value="False">
                                                <Setter TargetName="Modes" Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right column: what is missing, and where new maps come from -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Pictures" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Maps without a screenshot or radar image get a top-down view of their geometry, saved in tools\previews\auto. A .jpg or .png of your own in tools\previews always wins." />
                            <Button Content="{Binding GenerateThumbnailsText}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding GenerateThumbnailsCommand}" IsEnabled="{Binding CanGenerateThumbnails}" />
                            <TextBlock Text="{Binding GenerateProgress}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Navigation" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Without a nav file the bots learn the map during the first round. The Bots screen builds them in a hidden helper server, the game is not touched." />
                            <Button Content="{Binding QueueNavText}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding QueueMissingNavsCommand}" IsEnabled="{Binding CanQueueNavs}"
                                    ToolTip="Opens the Bots screen with every missing nav file queued; Apply there builds them" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Your own maps" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Put .bsp files or whole .zip, .rar or .7z archives into the custom-maps folder, then Update maps installs them and adds them to the map lists by their name." />
                            <TextBlock Text="Nothing new in custom-maps." Style="{StaticResource HintText}" Margin="0,0,0,12"
                                       Visibility="{Binding WaitingMaps.Count, Converter={StaticResource VisibleWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding WaitingMaps}" Focusable="False" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock x:Name="Kind" DockPanel.Dock="Right" Text="new map" Style="{StaticResource HintText}" />
                                            <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsArchive}" Value="True">
                                                <Setter TargetName="Kind" Property="Text" Value="archive" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding OpenCustomMapsFolderCommand}" />
                                <Button Content="Update maps" Style="{StaticResource SecondaryButton}" Command="{Binding UpdateMapsCommand}"
                                        ToolTip="Opens the Install screen and installs the map pack and the custom-maps folder" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
