# Created by the installer at runtime. server\ also holds the admin
# password in cstrike\addons\amxmodx\configs\users.ini.
# Anchored to the root: "server/" alone also matched app/CsServerControl/Server
# on Windows (case-insensitive) and kept the Server screen out of git.
/server/
tools/steamcmd/
tools/downloads/
tools/work/

# Maps the user drops in themselves, only the hint file belongs to the package.
custom-maps/*
!custom-maps/PUT_MAPS_HERE.txt


*.mdmp

# Server Control app: build output and the published exe (rebuilt with
# dotnet publish), plus the downloaded map previews.
app/**/bin/
app/**/obj/
app/publish/
app/.artifacts/
4_SERVER_CONTROL.exe
release/
tools/previews/
