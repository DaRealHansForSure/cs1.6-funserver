# Created by the installer at runtime. server\ also holds the admin
# password in cstrike\addons\amxmodx\configs\users.ini.
server/
tools/steamcmd/
tools/downloads/
tools/work/

# Maps the user drops in themselves, only the hint file belongs to the package.
custom-maps/*
!custom-maps/PUT_MAPS_HERE.txt


*.mdmp

# Server Control window: build output and the published exe (62 MB, rebuilt
# with tools\build-gui.ps1), plus the downloaded map previews.
gui/**/bin/
gui/**/obj/
gui/publish/
4_SERVER_CONTROL.exe
tools/previews/
